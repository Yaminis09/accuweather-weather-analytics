{
  "datasets": [
    {
      "name": "city_weather",
      "displayName": "City Weather Data",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.city_weather_summary",
        "dimensions": [
          {
            "name": "city_name",
            "expr": "city_name"
          }
        ],
        "measures": [
          {
            "name": "avg_temperature",
            "expr": "AVG(avg_temperature)"
          },
          {
            "name": "highest_temperature",
            "expr": "MAX(highest_temperature)"
          },
          {
            "name": "lowest_temperature",
            "expr": "MIN(lowest_temperature)"
          },
          {
            "name": "avg_humidity",
            "expr": "AVG(avg_humidity)"
          },
          {
            "name": "avg_wind_speed",
            "expr": "AVG(avg_wind_speed)"
          },
          {
            "name": "highest_wind_speed",
            "expr": "MAX(highest_wind_speed)"
          },
          {
            "name": "total_precipitation",
            "expr": "SUM(total_precipitation)"
          },
          {
            "name": "avg_visibility",
            "expr": "AVG(avg_visibility)"
          },
          {
            "name": "avg_uv_index",
            "expr": "AVG(avg_uv_index)"
          },
          {
            "name": "total_observations",
            "expr": "SUM(total_observations)"
          },
          {
            "name": "city_count",
            "expr": "COUNT(DISTINCT city_name)"
          }
        ]
      }
    }
  ],
